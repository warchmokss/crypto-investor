# Obtain token from @BotFather. Never commit the real .env file.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN
# Generate with: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_DB=crypto_investor
POSTGRES_USER=crypto_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
# Local docker-compose overrides DATABASE_URL and REDIS_URL for the app.
DATABASE_URL=postgres://crypto_app:REPLACE_WITH_STRONG_DATABASE_PASSWORD@localhost:5432/crypto_investor
REDIS_URL=redis://localhost:6379
PORT=3000
PG_POOL_MAX=20
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=
