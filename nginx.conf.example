# Example edge proxy. Terminate TLS at your load balancer / ingress.
upstream crypto_app {
    least_conn;
    # Add one entry per app replica. Keep all replicas on the same PostgreSQL + Redis.
    server app-1:3000 max_fails=3 fail_timeout=10s;
    server app-2:3000 max_fails=3 fail_timeout=10s;
    keepalive 256;
}
server {
    listen 80;
    server_name game.example.com;
    client_max_body_size 32k;
    location / {
        proxy_pass http://crypto_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
